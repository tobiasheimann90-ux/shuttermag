---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from './Layout.astro';
import { ARTIKEL_TYPEN, KATEGORIEN, SITE } from '../site.config';

interface Props {
	entry: CollectionEntry<'artikel'>;
}

const { entry } = Astro.props;
const {
	title,
	description,
	pubDate,
	updatedDate,
	kategorie,
	typ,
	heroImage,
	heroImageAlt,
	author,
	enthaeltAffiliateLinks,
} = entry.data;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Organization', name: author },
	publisher: { '@type': 'Organization', name: SITE.name },
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
};
---

<Layout title={`${title} · ${SITE.name}`} description={description}>
	<article class="mx-auto max-w-3xl px-4 py-10">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<div class="relative mt-2 overflow-hidden rounded-2xl bg-black">
			{
				heroImage && (
					<Image
						src={heroImage}
						alt={heroImageAlt ?? ''}
						width={1200}
						height={675}
						class="aspect-video w-full object-cover opacity-90"
						priority
					/>
				)
			}
			<div
				class:list={[
					'absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent',
					!heroImage && 'aspect-video',
				]}
			/>
			<div class="absolute inset-x-0 bottom-0 p-5 sm:p-8">
				<div class="flex items-center gap-2 text-sm">
					<a
						href={`/kategorie/${kategorie}/`}
						class="rounded-full bg-accent px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white transition hover:bg-accent/80"
					>
						{KATEGORIEN[kategorie]?.label ?? kategorie}
					</a>
					<span class="text-white/60" aria-hidden="true">·</span>
					<span class="text-white/80">{ARTIKEL_TYPEN[typ] ?? typ}</span>
				</div>

				<h1 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{title}</h1>

				<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-white/80">
					<span>{author}</span>
					<span aria-hidden="true">·</span>
					<time datetime={pubDate.toISOString()}>
						{pubDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
					</time>
					{
						updatedDate && (
							<>
								<span aria-hidden="true">·</span>
								<span>
									Aktualisiert am{' '}
									{updatedDate.toLocaleDateString('de-DE', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</span>
							</>
						)
					}
				</div>
			</div>
		</div>

		{
			enthaeltAffiliateLinks && (
				<p class="mt-6 rounded-xl border border-accent/20 bg-accent/5 px-4 py-3 text-sm text-slate-700">
					<strong class="text-accent">Werbung / Affiliate-Links:</strong> Dieser Artikel enthält
					Affiliate-Links. Kaufst du über einen dieser Links ein, erhalten wir ggf. eine Provision,
					ohne Mehrkosten für dich.
				</p>
			)
		}

		<div
			class="prose prose-slate mt-8 max-w-none prose-headings:scroll-mt-24 prose-a:font-semibold prose-a:text-accent prose-a:no-underline hover:prose-a:underline"
		>
			<slot />
		</div>
	</article>
</Layout>
