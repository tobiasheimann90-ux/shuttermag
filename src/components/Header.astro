---
import { Image } from 'astro:assets';
import { KATEGORIEN } from '../site.config';
import bildKameras from '../content/artikel/_images/mega-kameras.jpg';
import bildObjektive from '../content/artikel/_images/mega-objektive.jpg';
import bildZubehoer from '../content/artikel/_images/mega-zubehoer.jpg';
import bildBeleuchtung from '../content/artikel/_images/mega-beleuchtung.jpg';
import bildAudio from '../content/artikel/_images/mega-audio.jpg';

const alleKategorien = Object.entries(KATEGORIEN);
// "Themen"-Mega-Menü zeigt nur die Ausrüstungskategorien - Praxis-Guides und Software
// haben eigene, direkt sichtbare Nav-Punkte (siehe unten).
const themenKategorien = alleKategorien.filter(
	([slug]) => slug !== 'praxis-guides' && slug !== 'software'
);

const themenBilder: Record<string, ImageMetadata> = {
	kameras: bildKameras,
	objektive: bildObjektive,
	zubehoer: bildZubehoer,
	beleuchtung: bildBeleuchtung,
	audio: bildAudio,
};
---

<header class="sticky top-0 z-50 border-b border-black/10 bg-white/90 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
		<a href="/" class="shrink-0">
			<img src="/logo-black.svg" alt="SHUTTERMAG" class="h-6 w-auto" />
		</a>

		<!-- Desktop-Nav -->
		<nav class="hidden items-center gap-1 lg:flex">
			<div class="group">
				<button
					class="flex items-center gap-1 rounded-full px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
				>
					Themen
					<svg
						class="h-3.5 w-3.5 transition group-hover:rotate-180"
						viewBox="0 0 12 12"
						fill="none"
					>
						<path
							d="M2.5 4.5L6 8l3.5-3.5"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						></path>
					</svg>
				</button>

				<!-- Mega-Menu: opacity/pointer-events statt visibility, damit Links per Tab erreichbar bleiben -->
				<div
					class="pointer-events-none absolute inset-x-0 top-full opacity-0 transition duration-150 group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100"
				>
					<div class="border-t border-black/10 bg-white shadow-lg">
						<div class="mx-auto grid max-w-6xl grid-cols-4 gap-x-8 gap-y-6 px-4 py-8">
							{
								themenKategorien.map(([slug, { label, beschreibung }]) => (
									<a href={`/kategorie/${slug}/`} class="group/item block">
										<Image
											src={themenBilder[slug]}
											alt=""
											width={64}
											height={64}
											class="h-12 w-12 rounded-lg object-cover"
										/>
										<div class="mt-3 font-semibold text-slate-900 group-hover/item:text-accent">
											{label}
										</div>
										<p class="mt-1 text-sm text-slate-500">{beschreibung}</p>
									</a>
								))
							}
						</div>
					</div>
				</div>
			</div>

			<a
				href="/kategorie/praxis-guides/"
				class="rounded-full px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
			>
				Praxis-Guides
			</a>
			<a
				href="/kategorie/software/"
				class="rounded-full px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
			>
				Software
			</a>
			<a
				href="/newsletter/"
				class="rounded-full px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
			>
				Newsletter
			</a>
		</nav>

		<div class="hidden shrink-0 items-center gap-2 lg:flex">
			<a
				href="/kontakt/"
				class="rounded-full border border-black/10 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-black hover:text-slate-900"
			>
				Kontakt
			</a>
			<a
				href="/kamera-finder/"
				class="rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-dark"
			>
				Kamera-Finder
			</a>
		</div>

		<!-- Mobil: Kamera-Finder bleibt sichtbar, Rest hinter Hamburger -->
		<div class="flex items-center gap-2 lg:hidden">
			<a
				href="/kamera-finder/"
				class="rounded-full bg-accent px-3 py-1.5 text-sm font-semibold text-white"
			>
				Kamera-Finder
			</a>
			<details class="group/menu relative">
				<summary
					class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full border border-black/10 [&::-webkit-details-marker]:hidden"
					aria-label="Menü öffnen"
				>
					<svg class="h-4 w-4" viewBox="0 0 20 20" fill="none">
						<path
							d="M3 5.5h14M3 10h14M3 14.5h14"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
						></path>
					</svg>
				</summary>
				<div
					class="absolute top-full right-0 mt-2 w-64 rounded-2xl border border-black/10 bg-white p-3 shadow-lg"
				>
					<a
						href="/kontakt/"
						class="block rounded-full border border-black/10 px-4 py-2 text-center text-sm font-semibold text-slate-700"
					>
						Kontakt
					</a>

					<div class="mt-2 flex flex-col gap-0.5">
						<a
							href="/kategorie/praxis-guides/"
							class="rounded-lg px-2 py-2 text-sm text-slate-700 hover:bg-slate-100"
						>
							Praxis-Guides
						</a>
						<a
							href="/kategorie/software/"
							class="rounded-lg px-2 py-2 text-sm text-slate-700 hover:bg-slate-100"
						>
							Software
						</a>
						<a href="/newsletter/" class="rounded-lg px-2 py-2 text-sm text-slate-700 hover:bg-slate-100">
							Newsletter
						</a>
					</div>

					<details class="group mt-1">
						<summary
							class="flex cursor-pointer list-none items-center justify-between rounded-lg px-2 py-2 text-sm font-semibold text-slate-700 [&::-webkit-details-marker]:hidden"
						>
							Themen
							<svg
								class="h-3.5 w-3.5 transition group-open:rotate-180"
								viewBox="0 0 12 12"
								fill="none"
							>
								<path
									d="M2.5 4.5L6 8l3.5-3.5"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								></path>
							</svg>
						</summary>
						<div class="flex flex-col gap-0.5 py-1 pl-2">
							{
								themenKategorien.map(([slug, { label }]) => (
									<a
										href={`/kategorie/${slug}/`}
										class="rounded-lg px-2 py-2 text-sm text-slate-600 hover:bg-slate-100"
									>
										{label}
									</a>
								))
							}
						</div>
					</details>
				</div>
			</details>
		</div>
	</div>
</header>
