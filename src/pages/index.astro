---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ArtikelCard from '../components/ArtikelCard.astro';
import HeroPhotoGrid from '../components/HeroPhotoGrid.astro';
import { KATEGORIEN } from '../site.config';
import { tools } from '../data/tools';
import kameraFinderBild from '../content/artikel/_images/profikamera-grosses-objektiv.jpg';
import startHierBild from '../content/artikel/_images/kamera-display-einstellungen.jpg';
import aboutBild from '../content/artikel/_images/fotograf-wueste-about.jpg';

const alleArtikel = (await getCollection('artikel', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const neuesteArtikel = alleArtikel.slice(0, 9);
const featuredArtikel = alleArtikel.filter((a) => a.data.featured).slice(0, 4);
const kategorieEintraege = Object.entries(KATEGORIEN);
---

<Layout>
	<section class="relative overflow-hidden">
		<div
			class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center"
		>
			<div>
				<h1 class="max-w-2xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
					Kaufberatung, Tests &amp; Guides für <span class="text-accent">Foto-Equipment</span>
				</h1>
				<p class="mt-4 max-w-xl text-lg text-slate-600">
					SHUTTERMAG hilft dir, die richtige Kamera, das passende Objektiv und sinnvolles Zubehör zu
					finden – unabhängig recherchiert und praxisnah erklärt.
				</p>
				<div class="mt-8 flex flex-wrap gap-2">
					{
						kategorieEintraege.map(([slug, { label }]) => (
							<a
								href={`/kategorie/${slug}/`}
								class="rounded-full border border-black/10 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-black hover:text-slate-900"
							>
								{label}
							</a>
						))
					}
				</div>
			</div>
			<HeroPhotoGrid />
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pb-4">
		<div class="grid gap-8 sm:grid-cols-3">
			<div class="flex gap-3">
				<svg class="h-6 w-6 shrink-0 text-accent" viewBox="0 0 24 24" fill="none">
					<path
						d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linejoin="round"
					></path>
					<path
						d="M9 12l2 2 4-4"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					></path>
				</svg>
				<div>
					<h3 class="font-semibold text-slate-900">Unabhängig getestet</h3>
					<p class="mt-1 text-sm text-slate-600">
						Ehrliche Einschätzungen statt bezahlter Empfehlungen.
					</p>
				</div>
			</div>
			<div class="flex gap-3">
				<svg class="h-6 w-6 shrink-0 text-accent" viewBox="0 0 24 24" fill="none">
					<path
						d="M12 4v2m0 12v2m8-8h-2M6 12H4m12.95 5.95l-1.41-1.41M7.46 7.46 6.05 6.05m11.9 0-1.41 1.41M7.46 16.54l-1.41 1.41"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
					></path>
					<circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5"></circle>
				</svg>
				<div>
					<h3 class="font-semibold text-slate-900">Praxisnah erklärt</h3>
					<p class="mt-1 text-sm text-slate-600">
						Technik verständlich, ohne unnötiges Fachchinesisch.
					</p>
				</div>
			</div>
			<div class="flex gap-3">
				<svg class="h-6 w-6 shrink-0 text-accent" viewBox="0 0 24 24" fill="none">
					<path
						d="M4 12a8 8 0 1 1 3.5 6.6L4 20l1.2-3.6A7.96 7.96 0 0 1 4 12z"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linejoin="round"
					></path>
				</svg>
				<div>
					<h3 class="font-semibold text-slate-900">Aktiv statt passiv</h3>
					<p class="mt-1 text-sm text-slate-600">
						Tools wie der Kamera-Finder helfen bei der Entscheidung, nicht nur Artikel zum Lesen.
					</p>
				</div>
			</div>
		</div>
	</section>

	{
		featuredArtikel.length > 0 && (
			<section class="mx-auto max-w-6xl px-4 pt-8 pb-4 sm:pt-10">
				<h2 class="mb-6 text-xl font-semibold text-slate-900">Empfohlene Kaufberatungen</h2>
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{featuredArtikel.map((artikel) => (
						<ArtikelCard artikel={artikel} />
					))}
				</div>
			</section>
		)
	}

	<section id="neueste-artikel" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-8 pb-16 sm:pt-10">
		<h2 class="mb-6 text-xl font-semibold text-slate-900">Neueste Artikel</h2>
		{
			neuesteArtikel.length > 0 ? (
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{neuesteArtikel.map((artikel) => (
						<ArtikelCard artikel={artikel} />
					))}
				</div>
			) : (
				<p class="text-slate-500">Noch keine Artikel veröffentlicht.</p>
			)
		}
	</section>

	<section class="mx-auto max-w-6xl px-4 pb-16">
		<div class="relative overflow-hidden rounded-3xl bg-black">
			<div class="grid gap-6 lg:grid-cols-2 lg:items-center">
				<div class="px-8 py-10 sm:px-12 sm:py-14">
					<h2 class="text-2xl font-bold text-white sm:text-3xl">Welche Kamera passt zu dir?</h2>
					<p class="mt-3 max-w-sm text-white/70">
						Budget und Einsatzzweck eingeben und die passende Kamera für dich finden – in 2
						Minuten statt stundenlangem Recherchieren.
					</p>
					<a
						href="/kamera-finder/"
						class="mt-6 inline-block rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-dark"
					>
						Zum Kamera-Finder
					</a>
				</div>
				<div class="relative hidden h-64 lg:block lg:h-full lg:min-h-[280px]">
					<Image
						src={kameraFinderBild}
						alt=""
						width={700}
						height={500}
						class="absolute inset-0 h-full w-full object-cover"
					/>
					<div class="absolute inset-0 bg-gradient-to-r from-black via-black/30 to-transparent" />
				</div>
			</div>
		</div>
	</section>

	<section class="bg-slate-50">
		<div class="mx-auto max-w-6xl px-4 py-16">
			<h2 class="mb-6 text-xl font-semibold text-slate-900">Kategorien</h2>
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					kategorieEintraege.map(([slug, { label, beschreibung }]) => (
						<a
							href={`/kategorie/${slug}/`}
							class="rounded-2xl border border-black/10 bg-white p-5 transition hover:border-black"
						>
							<h3 class="font-semibold text-slate-900">
								{label}
								<span class="ml-1 text-accent transition group-hover:translate-x-0.5">→</span>
							</h3>
							<p class="mt-1 text-sm text-slate-600">{beschreibung}</p>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-16">
		<div class="relative overflow-hidden rounded-3xl bg-black">
			<div class="grid gap-6 lg:grid-cols-2 lg:items-center">
				<div class="relative order-2 hidden h-64 lg:order-1 lg:block lg:h-full lg:min-h-[280px]">
					<Image
						src={startHierBild}
						alt=""
						width={700}
						height={500}
						class="absolute inset-0 h-full w-full object-cover"
					/>
					<div class="absolute inset-0 bg-gradient-to-l from-black via-black/30 to-transparent" />
				</div>
				<div class="order-1 px-8 py-10 sm:px-12 sm:py-14 lg:order-2">
					<h2 class="text-2xl font-bold text-white sm:text-3xl">
						Neu in der Fotografie? Starte hier.
					</h2>
					<p class="mt-3 max-w-sm text-white/70">
						Unsicher, welche Kamera oder welches Objektiv du kaufen sollst? Unser Einsteiger-Guide
						führt dich Schritt für Schritt durch die erste Kaufentscheidung.
					</p>
					<a
						href="/start-hier/"
						class="mt-6 inline-block rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-dark"
					>
						Zum Einsteiger-Guide
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-16">
		<div class="flex items-baseline justify-between gap-4">
			<h2 class="text-xl font-semibold text-slate-900">Tools</h2>
			<a href="/tools/" class="text-sm font-semibold text-accent hover:underline">Alle Tools →</a>
		</div>
		<div class="mt-6 grid gap-6 sm:grid-cols-3">
			{
				tools.map((tool) => (
					<a
						href={tool.href}
						class="flex flex-col justify-between rounded-2xl border border-black/10 p-6 transition hover:-translate-y-0.5 hover:shadow-lg"
					>
						<div>
							<span
								class={
									tool.status === 'verfuegbar'
										? 'inline-block rounded-full bg-accent/10 px-2.5 py-1 text-xs font-semibold text-accent'
										: 'inline-block rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-500'
								}
							>
								{tool.status === 'verfuegbar' ? 'Verfügbar' : 'In Planung'}
							</span>
							<h3 class="mt-3 text-lg font-semibold text-slate-900">{tool.titel}</h3>
							<p class="mt-2 text-sm text-slate-600">{tool.beschreibung}</p>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pb-16">
		<div class="grid gap-8 overflow-hidden rounded-3xl border border-black/10 lg:grid-cols-2 lg:items-center">
			<div class="relative h-56 lg:h-full lg:min-h-[320px]">
				<Image
					src={aboutBild}
					alt="Fotograf bei der Arbeit in der Wüstenlandschaft"
					width={700}
					height={600}
					class="h-full w-full object-cover"
				/>
			</div>
			<div class="px-8 pb-10 sm:px-12 lg:pb-14 lg:pl-0">
				<h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Warum du SHUTTERMAG vertrauen kannst</h2>
				<!-- TODO: echte Biografie ergänzen (seit wann Fotografie, Hintergrund, eigener Antrieb) -->
				<p class="mt-3 max-w-md text-slate-600">
					Hinter SHUTTERMAG steckt Tobias. Jede Kaufberatung basiert auf echter Nutzung im Alltag,
					auf Reisen, im Studio, unterwegs, nicht auf bezahlten Kooperationen. Wenn wir etwas
					nicht empfehlen können, sagen wir das auch so.
				</p>
				<a href="/kontakt/" class="mt-6 inline-block text-sm font-semibold text-accent hover:underline">
					Kontakt aufnehmen →
				</a>
			</div>
		</div>
	</section>

	<section class="bg-slate-50">
		<div class="mx-auto max-w-6xl px-4 py-16">
			<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
				<div>
					<h2 class="text-xl font-semibold text-slate-900">Newsletter</h2>
					<p class="mt-1 max-w-sm text-sm text-slate-600">
						Einmal pro Woche: neue Artikel, eine Gear-Empfehlung und ein praktischer Tipp.
					</p>
				</div>
				<form id="home-newsletter-form" class="flex w-full max-w-md gap-2 sm:w-auto">
					<input
						type="email"
						name="email"
						required
						placeholder="deine@email.de"
						class="min-w-0 flex-1 rounded-full border border-black/10 bg-white px-4 py-2.5 text-sm focus:border-black focus:outline-none"
					/>
					<button
						type="submit"
						class="shrink-0 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-dark"
					>
						Anmelden
					</button>
				</form>
			</div>
			<p id="home-newsletter-hinweis" class="mt-3 hidden text-sm text-slate-500"></p>
		</div>
	</section>
</Layout>

<script>
	// TODO: An echten E-Mail-Anbieter anbinden (z.B. Brevo/Mailcoach), sobald ausgewählt.
	const form = document.querySelector<HTMLFormElement>('#home-newsletter-form');
	const hinweis = document.querySelector<HTMLParagraphElement>('#home-newsletter-hinweis');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (hinweis) {
			hinweis.textContent =
				'Newsletter-Anmeldung folgt in Kürze. Anbindung an den Versand ist noch in Arbeit.';
			hinweis.classList.remove('hidden');
		}
	});
</script>
