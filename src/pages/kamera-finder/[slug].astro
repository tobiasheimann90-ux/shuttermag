---
import Layout from '../../layouts/Layout.astro';
import { kameras, sensorformatLabels, useCaseLabels } from '../../data/kameras';

export async function getStaticPaths() {
	return kameras.map((kamera) => ({
		params: { slug: kamera.slug },
		props: { kamera },
	}));
}

const { kamera } = Astro.props;
---

<Layout
	title={`${kamera.modell} · Kamera-Finder · SHUTTERMAG`}
	description={kamera.kurzbeschreibung}
>
	<article class="mx-auto max-w-3xl px-4 py-10">
		<a href="/kamera-finder/" class="text-sm font-semibold text-accent hover:underline">
			← Zurück zum Kamera-Finder
		</a>

		<div class="mt-4 flex items-center gap-2">
			<span class="text-xs font-semibold uppercase tracking-wider text-accent">{kamera.marke}</span>
			<span class="text-slate-400">·</span>
			<span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-600">
				{sensorformatLabels[kamera.sensorformat]}
			</span>
		</div>

		<h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
			{kamera.modell}
		</h1>
		<p class="mt-3 max-w-xl text-slate-600">{kamera.kurzbeschreibung}</p>

		<p class="mt-4 inline-block rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
			Beispieldaten – Preis ist ein Richtwert, kein Live-Preis
		</p>

		<div class="mt-8 overflow-hidden rounded-2xl border border-black/10">
			<table class="w-full text-sm">
				<tbody>
					<tr class="border-b border-black/5">
						<td class="bg-slate-50 px-4 py-3 font-medium text-slate-500">Preis (circa)</td>
						<td class="px-4 py-3 font-semibold text-slate-900">{kamera.preisCirca} €</td>
					</tr>
					<tr class="border-b border-black/5">
						<td class="bg-slate-50 px-4 py-3 font-medium text-slate-500">Mount</td>
						<td class="px-4 py-3 text-slate-900">{kamera.mount}</td>
					</tr>
					<tr class="border-b border-black/5">
						<td class="bg-slate-50 px-4 py-3 font-medium text-slate-500">Sensorformat</td>
						<td class="px-4 py-3 text-slate-900">{sensorformatLabels[kamera.sensorformat]}</td>
					</tr>
					<tr class="border-b border-black/5">
						<td class="bg-slate-50 px-4 py-3 font-medium text-slate-500">Auflösung</td>
						<td class="px-4 py-3 text-slate-900">{kamera.megapixel} MP</td>
					</tr>
					<tr class="border-b border-black/5">
						<td class="bg-slate-50 px-4 py-3 font-medium text-slate-500">Gewicht</td>
						<td class="px-4 py-3 text-slate-900">{kamera.gewichtGramm} g</td>
					</tr>
					<tr class="border-b border-black/5">
						<td class="bg-slate-50 px-4 py-3 font-medium text-slate-500">Video</td>
						<td class="px-4 py-3 text-slate-900">{kamera.videoAufloesung}</td>
					</tr>
					<tr>
						<td class="bg-slate-50 px-4 py-3 font-medium text-slate-500">Klappdisplay</td>
						<td class="px-4 py-3 text-slate-900">{kamera.klappdisplay ? 'Ja' : 'Nein'}</td>
					</tr>
				</tbody>
			</table>
		</div>

		<div class="mt-8 grid gap-6 sm:grid-cols-2">
			<div>
				<h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Vorteile</h2>
				<ul class="mt-3 space-y-2 text-sm text-slate-700">
					{kamera.vorteile.map((v) => <li>+ {v}</li>)}
				</ul>
			</div>
			<div>
				<h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Nachteile</h2>
				<ul class="mt-3 space-y-2 text-sm text-slate-700">
					{kamera.nachteile.map((n) => <li>− {n}</li>)}
				</ul>
			</div>
		</div>

		<div class="mt-8 flex flex-wrap gap-2">
			{kamera.useCases.map((uc) => (
				<span class="rounded-full border border-black/10 px-3 py-1 text-xs font-medium text-slate-600">
					{useCaseLabels[uc]}
				</span>
			))}
		</div>

		<div class="mt-10 rounded-xl border border-black/10 bg-slate-50 px-4 py-3 text-sm text-slate-500">
			<!-- TODO: Sobald Affiliate-Programme angebunden sind, hier über /go/<slug>/ verlinken -->
			Preisvergleich & Kauf-Links folgen, sobald Affiliate-Partner angebunden sind.
		</div>
	</article>
</Layout>
