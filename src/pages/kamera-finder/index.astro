---
import Layout from '../../layouts/Layout.astro';
import { kameras, sensorformatLabels, useCaseLabels } from '../../data/kameras';
---

<Layout
	title="Kamera-Finder · SHUTTERMAG"
	description="Finde die passende Kamera nach Budget, Einsatzzweck und Sensorformat, gefiltert aus unserer Kamera-Datenbank."
>
	<section class="mx-auto max-w-6xl px-4 py-12">
		<h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Kamera-Finder</h1>
		<p class="mt-3 max-w-xl text-slate-600">
			Budget und Einsatzzweck eingeben, passende Kameras filtern. Prototyp, die Auswahl wird
			laufend erweitert.
		</p>
		<p class="mt-3 inline-block rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
			Beispieldaten – Preise sind Richtwerte
		</p>

		<div id="finder-filter" class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
			<input
				id="filter-suche"
				type="text"
				placeholder="Marke oder Modell suchen…"
				class="rounded-full border border-black/10 px-4 py-2.5 text-sm focus:border-black focus:outline-none lg:col-span-2"
			/>
			<select
				id="filter-budget"
				class="select-chevron rounded-full border border-black/10 py-2.5 pl-4 text-sm focus:border-black focus:outline-none"
			>
				<option value="alle">Budget: alle</option>
				<option value="700">bis 700 €</option>
				<option value="1000">bis 1.000 €</option>
				<option value="1500">bis 1.500 €</option>
				<option value="2500">bis 2.500 €</option>
			</select>
			<select
				id="filter-usecase"
				class="select-chevron rounded-full border border-black/10 py-2.5 pl-4 text-sm focus:border-black focus:outline-none"
			>
				<option value="alle">Einsatzzweck: alle</option>
				{
					Object.entries(useCaseLabels).map(([value, label]) => (
						<option value={value}>{label}</option>
					))
				}
			</select>
			<select
				id="filter-sensor"
				class="select-chevron rounded-full border border-black/10 py-2.5 pl-4 text-sm focus:border-black focus:outline-none"
			>
				<option value="alle">Sensorformat: alle</option>
				{
					Object.entries(sensorformatLabels).map(([value, label]) => (
						<option value={value}>{label}</option>
					))
				}
			</select>
		</div>

		<p id="finder-ergebnis-anzahl" class="mt-6 text-sm text-slate-500"></p>

		<div id="finder-grid" class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				kameras.map((kamera) => (
					<a
						href={`/kamera-finder/${kamera.slug}/`}
						data-kamera-card
						data-name={`${kamera.marke} ${kamera.modell}`.toLowerCase()}
						data-preis={kamera.preisCirca}
						data-usecases={kamera.useCases.join(',')}
						data-sensor={kamera.sensorformat}
						class="flex flex-col justify-between rounded-2xl border border-black/10 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg"
					>
						<div>
							<div class="flex items-center justify-between gap-2">
								<span class="text-xs font-semibold uppercase tracking-wider text-accent">
									{kamera.marke}
								</span>
								<span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-medium text-slate-600">
									{sensorformatLabels[kamera.sensorformat]}
								</span>
							</div>
							<h2 class="mt-2 text-lg font-semibold text-slate-900">{kamera.modell}</h2>
							<p class="mt-2 text-sm text-slate-600">{kamera.kurzbeschreibung}</p>
						</div>
						<div class="mt-4 flex items-center justify-between border-t border-black/5 pt-3">
							<span class="text-sm text-slate-500">{kamera.megapixel} MP · {kamera.gewichtGramm} g</span>
							<span class="font-semibold text-slate-900">ca. {kamera.preisCirca} €</span>
						</div>
					</a>
				))
			}
		</div>

		<p id="finder-leer" class="mt-10 hidden text-center text-slate-500">
			Keine Kamera passt zu diesen Filtern. Versuch's mit weniger Einschränkungen.
		</p>

		<div class="mt-16 rounded-2xl border border-black/10 bg-slate-50 p-6">
			<p class="text-sm text-slate-600">
				Als Nächstes geplant: <a href="/tools/objektiv-vergleich/" class="font-semibold text-accent hover:underline">Objektiv-Vergleichs-Tool</a>
				{' '}und <a href="/tools/setup-konfigurator/" class="font-semibold text-accent hover:underline">Setup-Konfigurator</a>.
				<a href="/tools/" class="ml-1 hover:underline">Alle Tools ansehen →</a>
			</p>
		</div>
	</section>
</Layout>

<script>
	const sucheInput = document.querySelector<HTMLInputElement>('#filter-suche')!;
	const budgetSelect = document.querySelector<HTMLSelectElement>('#filter-budget')!;
	const usecaseSelect = document.querySelector<HTMLSelectElement>('#filter-usecase')!;
	const sensorSelect = document.querySelector<HTMLSelectElement>('#filter-sensor')!;
	const karten = document.querySelectorAll<HTMLAnchorElement>('[data-kamera-card]');
	const ergebnisAnzahl = document.querySelector<HTMLParagraphElement>('#finder-ergebnis-anzahl')!;
	const leerHinweis = document.querySelector<HTMLParagraphElement>('#finder-leer')!;

	function filtern() {
		const suche = sucheInput.value.trim().toLowerCase();
		const budget = budgetSelect.value;
		const usecase = usecaseSelect.value;
		const sensor = sensorSelect.value;

		let sichtbar = 0;

		karten.forEach((karte) => {
			const passtSuche = !suche || karte.dataset.name!.includes(suche);
			const passtBudget = budget === 'alle' || Number(karte.dataset.preis) <= Number(budget);
			const passtUsecase = usecase === 'alle' || karte.dataset.usecases!.split(',').includes(usecase);
			const passtSensor = sensor === 'alle' || karte.dataset.sensor === sensor;
			const treffer = passtSuche && passtBudget && passtUsecase && passtSensor;

			karte.classList.toggle('hidden', !treffer);
			if (treffer) sichtbar++;
		});

		ergebnisAnzahl.textContent = `${sichtbar} von ${karten.length} Kameras`;
		leerHinweis.classList.toggle('hidden', sichtbar !== 0);
	}

	[sucheInput, budgetSelect, usecaseSelect, sensorSelect].forEach((el) =>
		el.addEventListener('input', filtern)
	);

	filtern();
</script>
