---
import Layout from '../layouts/Layout.astro';

const produkte = [
	{
		titel: 'Kamera & Objektiv-Kaufberatung Masterclass',
		typ: 'Online-Kurs',
		beschreibung: 'Systematisch die richtige Kaufentscheidung treffen – Schritt für Schritt erklärt.',
	},
	{
		titel: 'Das große Objektiv-Handbuch',
		typ: 'E-Book / Guide',
		beschreibung: 'Nachschlagewerk zu Brennweiten, Blenden und Einsatzgebieten.',
	},
	{
		titel: 'Lightroom-Presets',
		typ: 'Presets',
		beschreibung: 'Bearbeitungs-Presets für bestimmte Bildstile, direkt einsetzbar.',
	},
];
---

<Layout
	title="Produkte · SHUTTERMAG"
	description="Eigene digitale Produkte von SHUTTERMAG: Kurse, E-Books und Presets (in Planung)."
	noindex
>
	<section class="mx-auto max-w-6xl px-4 py-16">
		<h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Produkte</h1>
		<p class="mt-4 max-w-xl text-slate-600">
			Neben Kaufberatungen und Tools planen wir eigene digitale Produkte, die auf der Expertise von
			SHUTTERMAG aufbauen – noch in Planung.
		</p>

		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				produkte.map((produkt) => (
					<div class="flex flex-col justify-between rounded-2xl border border-black/10 p-6">
						<div>
							<span class="inline-block rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-500">
								In Planung
							</span>
							<div class="mt-3 text-xs font-semibold uppercase tracking-wider text-accent">
								{produkt.typ}
							</div>
							<h2 class="mt-1 text-lg font-semibold text-slate-900">{produkt.titel}</h2>
							<p class="mt-2 text-sm text-slate-600">{produkt.beschreibung}</p>
						</div>
					</div>
				))
			}
		</div>

		<div class="mt-10 rounded-2xl border border-black/10 bg-slate-50 p-6">
			<h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">
				Was dafür noch fehlt
			</h2>
			<ul class="mt-4 space-y-3 text-sm text-slate-700">
				<li><strong>Inhalte erstellen</strong> – Kursvideos, E-Book-Text, Presets selbst</li>
				<li>
					<strong>Verkaufsplattform wählen</strong> – kein eigener Checkout, sondern extern (z.B.
					Gumroad, Lemon Squeezy, Digistore24 – übernehmen Zahlung, Auslieferung, Widerrufsrecht)
				</li>
				<li>
					<strong>Verlinkung</strong> – sobald eine Plattform gewählt ist, verlinken diese Karten
					direkt dorthin
				</li>
			</ul>
		</div>
	</section>
</Layout>
