---
import Layout from '../../layouts/Layout.astro';

const tools = [
	{
		titel: 'Kamera-Finder',
		beschreibung:
			'Budget und Einsatzzweck eingeben, passende Kameras filtern und vergleichen.',
		href: '/kamera-finder/',
		status: 'verfuegbar' as const,
	},
	{
		titel: 'Objektiv-Vergleichs-Tool',
		beschreibung: 'Objektive nach Brennweite, Blende, System und Preis filtern und direkt vergleichen.',
		href: '/tools/objektiv-vergleich/',
		status: 'geplant' as const,
	},
	{
		titel: 'Setup-Konfigurator',
		beschreibung:
			'Use-Case und Budget wählen (Reise, YouTube, Produktfotografie) und ein komplettes Equipment-Paket vorgeschlagen bekommen.',
		href: '/tools/setup-konfigurator/',
		status: 'geplant' as const,
	},
];
---

<Layout
	title="Tools · SHUTTERMAG"
	description="Interaktive Tools von SHUTTERMAG: Kamera-Finder, Objektiv-Vergleich und Setup-Konfigurator."
>
	<section class="mx-auto max-w-6xl px-4 py-16">
		<h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Tools</h1>
		<p class="mt-4 max-w-xl text-slate-600">
			SHUTTERMAG soll mehr sein als ein Blog: aktive Entscheidungshilfen statt nur Artikel zum
			Durchlesen.
		</p>

		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				tools.map((tool) => (
					<a
						href={tool.href}
						class="flex flex-col justify-between rounded-2xl border border-black/10 p-6 transition hover:-translate-y-0.5 hover:shadow-lg"
					>
						<div>
							<span
								class={
									tool.status === 'verfuegbar'
										? 'inline-block rounded-full bg-accent/10 px-2.5 py-1 text-xs font-semibold text-accent'
										: 'inline-block rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-500'
								}
							>
								{tool.status === 'verfuegbar' ? 'Verfügbar' : 'In Planung'}
							</span>
							<h2 class="mt-3 text-lg font-semibold text-slate-900">{tool.titel}</h2>
							<p class="mt-2 text-sm text-slate-600">{tool.beschreibung}</p>
						</div>
					</a>
				))
			}
		</div>
	</section>
</Layout>
